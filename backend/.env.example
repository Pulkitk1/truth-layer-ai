# Backend configuration (copy to backend/.env). Never commit the real .env.
# Largest accepted PDF in MB. PDFs are stored in the database, so values above 20 are capped at 20.
MAX_UPLOAD_MB=20
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Groq (AI claim extraction). Get a key at https://console.groq.com/keys ---
# Server-side only. Never put this in a NEXT_PUBLIC_* variable.
GROQ_API_KEY=
# Any Groq chat model that supports JSON mode (default shown)
GROQ_MODEL=openai/gpt-oss-120b
# Per-request timeout in seconds
GROQ_TIMEOUT_SECONDS=60
# Max characters of PDF text per Groq request, and max requests per document
CLAIM_CHUNK_CHARS=6000
CLAIM_MAX_CHUNKS=40

# --- Tavily (live web search for evidence). Get a key at https://app.tavily.com ---
# Server-side only. Never put this in a NEXT_PUBLIC_* variable.
TAVILY_API_KEY=
# basic = 1 credit per search (default, conserves free credits); advanced = 2 credits, deeper results
TAVILY_SEARCH_DEPTH=basic
# Sources kept per claim, and results requested per query (re-ranked by source trust, then trimmed)
TAVILY_MAX_RESULTS=5
TAVILY_FETCH_RESULTS=8
TAVILY_TIMEOUT_SECONDS=20
# Max claims searched per document (protects credits; extra claims are marked "skipped")
MAX_SEARCH_CLAIMS=50

# --- Environment ---
# development (default) or production. production turns off the /docs API explorer, always sends HSTS, and is
# required for GET /api/health to report production_ready=true.
APP_ENV=development
# Only these websites may call the API from a browser (comma-separated, no "*"). Production: https:// origins only.
# (CORS_ORIGINS is also set near the top of this file; keep one definition.)

# --- Database (Neon PostgreSQL). Server-side only: never put these in a NEXT_PUBLIC_* variable. ---
# Neon console > Connect. Use the POOLED connection string (host contains "-pooler") for the app.
DATABASE_URL=
# Direct (non-pooled) string, used only by Alembic migrations: the same URL without "-pooler" in the host.
# Leave blank to run migrations through DATABASE_URL.
DATABASE_DIRECT_URL=
# Connection pool size per backend process, extra connections allowed under load, and seconds to wait for one
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=15

# --- File storage ---
# Uploaded PDFs and generated reports are stored in the database above (table file_objects). There is nothing else to
# configure: no bucket, no extra credentials. The upload limit is MAX_UPLOAD_MB at the top of this file.

# --- Retention ---
# Documents (with their stored PDF, reports and results) are deleted this many days after upload. 0 = keep forever.
DOCUMENT_RETENTION_DAYS=30
# How often the running backend checks for expired documents, and how recently a "running" job still protects its document
RETENTION_SWEEP_MINUTES=60
ACTIVE_JOB_MINUTES=30

# --- Abuse protection ---
RATE_LIMIT_ENABLED=true
# Requests per client IP per minute
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_EXTRACT_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=120
RATE_LIMIT_VERIFY_PER_MINUTE=60
RATE_LIMIT_DEFAULT_PER_MINUTE=300
# How many reverse proxies sit in front of the API (0 = none). Only then is X-Forwarded-For trusted for the client IP.
TRUSTED_PROXY_COUNT=0
# Optional: a header the proxy OVERWRITES with the real client IP (Render: CF-Connecting-IP). Only used when
# TRUSTED_PROXY_COUNT is above 0; ignored when missing or not an IP address.
CLIENT_IP_HEADER=
# Per document: Groq claim extractions per hour, and the page limit for a PDF
MAX_CLAIM_EXTRACTIONS_PER_HOUR=10
MAX_PDF_PAGES=300
